{
  "_comment": "Framework-Berechtigungsvorlage (Ebene 3 + Overlay-Erweiterungen). Mechanismus laut Devin-Dokumentation: deny > ask > allow; Regeln werden über Ebenen zusammengeführt. Platzhalter in spitzen Klammern durch den Overlay Owner ersetzen. Die mit _core markierten Regeln dürfen vom Projekt nicht entfernt werden (tests/scripts/validate-framework.py prüft dies). Exakte Schlüsselstruktur und Muster-Semantik: <VERIFY AGAINST CURRENT DEVIN DOCUMENTATION>.",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/secrets/**)",
      "Read(**/*secret*)",
      "Read(**/*credential*)",
      "Read(<EXCLUDED_PATHS>)",
      "Write(AGENTS.md)",
      "Write(AGENTS.local.md)",
      "Write(.devin/**)",
      "Write(framework/**)",
      "Write(project-overlay/**)",
      "Write(**/*.lock)",
      "Write(**/package-lock.json)",
      "Write(**/yarn.lock)",
      "Write(**/pnpm-lock.yaml)",
      "Write(**/poetry.lock)",
      "Write(**/Cargo.lock)",
      "Write(**/go.sum)",
      "Write(<CI_CONFIG_PATHS>)",
      "Write(<QUALITY_GATE_CONFIG_PATHS>)",
      "Write(<EXCLUDED_PATHS>)",
      "Exec(git push)",
      "Exec(git merge)",
      "Exec(git rebase)",
      "Exec(git reset --hard)",
      "Exec(git tag)",
      "Exec(git branch -D)",
      "Exec(git clean)",
      "Exec(git remote)",
      "Exec(rm -rf)",
      "Exec(sudo)",
      "Exec(su )",
      "Exec(curl)",
      "Exec(wget)",
      "Exec(ssh)",
      "Exec(scp)",
      "Exec(chmod 777)",
      "Exec(npm publish)",
      "Exec(docker push)",
      "Exec(kubectl)",
      "Exec(helm)",
      "Exec(terraform)",
      "Fetch(*)"
    ],
    "ask": [
      "Write(**)",
      "Exec(<BUILD_COMMAND>)",
      "Exec(<TEST_COMMAND>)",
      "Exec(<LINT_COMMAND>)",
      "mcp__*"
    ],
    "allow": [
      "Read(**)",
      "Exec(git status)",
      "Exec(git diff)",
      "Exec(git log)",
      "Exec(git show)",
      "Exec(git blame)"
    ]
  },
  "_core_rules_integrity": {
    "deny_must_contain": [
      "Read(.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Write(AGENTS.md)",
      "Write(.devin/**)",
      "Write(framework/**)",
      "Write(project-overlay/**)",
      "Exec(git push)",
      "Exec(git merge)",
      "Exec(git reset --hard)",
      "Exec(rm -rf)",
      "Exec(sudo)"
    ]
  }
}
