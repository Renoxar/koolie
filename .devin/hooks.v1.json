{
  "PreToolUse": [
    {
      "matcher": "exec|edit|write",
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"$DEVIN_PROJECT_DIR/tests/scripts/hook-check-secrets.py\"",
          "timeout": 10
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"$DEVIN_PROJECT_DIR/tests/scripts/hook-overlay-status.py\"",
          "timeout": 10
        }
      ]
    }
  ]
}
