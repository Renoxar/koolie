# Persönliche, nicht zu teilende Devin-Konfiguration (Framework-Konvention)
AGENTS.local.md
.devin/config.local.json
.devin/mcp_config.local.json
.devin/plans/
# Bytecode der Python-Werkzeuge (install.py importiert clientmap.py)
__pycache__/
# Legacy-Verzeichnisse werden nicht gepflegt
.windsurf/
# Build-Artefakte der Dokumentation (Quellen unter devin-core-framework/build/doc werden versioniert)
devin-core-framework/build/out/

# ---------------------------------------------------------------------------
# Im Framework-Repository sind die Wurzelbestandteile Erzeugnisse:
# Quelle der Wahrheit ist devin-core-framework/root-template/, angelegt werden sie
# mit "python devin-core-framework/install.py". So kann es keine zwei
# auseinanderlaufenden Fassungen derselben Core-Datei geben.
#
# ACHTUNG: In einem PROJEKT gilt das Gegenteil - dort werden AGENTS.md, .devin/ und
# project-overlay/ versioniert. Diese vier Zeilen sind deshalb beim Übernehmen des
# Frameworks in ein Projekt NICHT mitzunehmen.
# ---------------------------------------------------------------------------
/AGENTS.md
/AGENTS.local.md.example
/.devin/
/project-overlay/
