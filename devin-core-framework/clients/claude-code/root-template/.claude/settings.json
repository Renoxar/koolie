{
  "_comment": "Framework-Berechtigungsvorlage, Client Pack claude-code (Ebene 3 + Overlay-Erweiterungen). Mechanismus: deny > ask > allow. Platzhalter in spitzen Klammern durch den Overlay Owner ersetzen. Die mit _core_rules_integrity markierten Regeln duerfen vom Projekt nicht entfernt werden (devin-core-framework/tests/scripts/validate-framework.py prueft dies). Zwei Abweichungen gegenueber dem Client Pack devin-desktop, beide Verschaerfungen: Schreibschutz erfordert je Pfad eine Edit- und eine Write-Regel, weil Claude Code beide Werkzeuge trennt; Befehlsverbote wirken praefixbasiert und damit breiter (Bash(git reset:*) sperrt jedes git reset, nicht nur --hard). Exakte Mustersemantik: <VERIFY AGAINST CURRENT CLIENT DOCUMENTATION>.",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/secrets/**)",
      "Read(**/*secret*)",
      "Read(**/*credential*)",
      "Read(<EXCLUDED_PATHS>)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)",
      "Edit(./CLAUDE.local.md)",
      "Write(./CLAUDE.local.md)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(devin-core-framework/framework/**)",
      "Write(devin-core-framework/framework/**)",
      "Edit(project-overlay/**)",
      "Write(project-overlay/**)",
      "Edit(**/*.lock)",
      "Write(**/*.lock)",
      "Edit(**/package-lock.json)",
      "Write(**/package-lock.json)",
      "Edit(**/yarn.lock)",
      "Write(**/yarn.lock)",
      "Edit(**/pnpm-lock.yaml)",
      "Write(**/pnpm-lock.yaml)",
      "Edit(**/poetry.lock)",
      "Write(**/poetry.lock)",
      "Edit(**/Cargo.lock)",
      "Write(**/Cargo.lock)",
      "Edit(**/go.sum)",
      "Write(**/go.sum)",
      "Edit(<CI_CONFIG_PATHS>)",
      "Write(<CI_CONFIG_PATHS>)",
      "Edit(<QUALITY_GATE_CONFIG_PATHS>)",
      "Write(<QUALITY_GATE_CONFIG_PATHS>)",
      "Edit(<EXCLUDED_PATHS>)",
      "Write(<EXCLUDED_PATHS>)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git tag:*)",
      "Bash(git branch:*)",
      "Bash(git clean:*)",
      "Bash(git remote:*)",
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(chmod:*)",
      "Bash(npm publish:*)",
      "Bash(docker push:*)",
      "Bash(kubectl:*)",
      "Bash(helm:*)",
      "Bash(terraform:*)",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Edit(**)",
      "Write(**)",
      "Bash(<BUILD_COMMAND>)",
      "Bash(<TEST_COMMAND>)",
      "Bash(<LINT_COMMAND>)",
      "mcp__*"
    ],
    "allow": [
      "Read(**)",
      "Grep(**)",
      "Glob(**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/devin-core-framework/tests/scripts/hook-check-secrets.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/devin-core-framework/tests/scripts/hook-overlay-status.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "_core_rules_integrity": {
    "deny_must_contain": [
      "Read(./.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(devin-core-framework/framework/**)",
      "Write(devin-core-framework/framework/**)",
      "Edit(project-overlay/**)",
      "Write(project-overlay/**)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git reset:*)",
      "Bash(rm:*)",
      "Bash(sudo:*)"
    ]
  }
}
